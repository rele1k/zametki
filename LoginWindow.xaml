<Window x:Class="Zametki.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход через Kimi" Width="980" Height="720"
        WindowStartupLocation="CenterOwner" Background="#F7F4EE">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="WebView" Grid.Row="0"/>
        <Border Grid.Row="1" Background="#26201A" Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Запуск…" Foreground="#ECE5D8" FontSize="12"/>
                <TextBlock x:Name="UrlText" Foreground="#8B8073" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
