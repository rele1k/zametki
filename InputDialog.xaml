<Window x:Class="Zametki.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F4EE">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptLabel" FontSize="14" Foreground="#26201A" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Height="36" Padding="10,6" Background="#FCFAF6"
                 Foreground="#26201A" BorderBrush="#DED6C8" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Width="90" Height="34"
                    Background="#ECE5D8" Foreground="#26201A" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Click="OnOk" Width="90" Height="34"
                    Background="#B44F1E" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
