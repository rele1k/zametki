<Window x:Class="Zametki.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки" Width="1180" Height="740" MinWidth="920" MinHeight="580"
        Background="#F7F4EE" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- ============ ВХОД ============ -->
        <Grid x:Name="LoginView">
            <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="18" Background="#B44F1E"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="З" FontSize="36" Foreground="White" FontFamily="Georgia"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Заметки" FontSize="32" FontFamily="Georgia" Foreground="#26201A"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Войдите через Kimi, чтобы заметки синхронизировались на всех устройствах"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="#6E6459"
                           Margin="0,8,0,24"/>
                <Button Content="Войти через Kimi" Click="OnLoginClicked" Height="46"
                        Background="#B44F1E" Foreground="White" FontSize="15" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock x:Name="LoginHint"
                           Text="Сначала укажите адрес сервера в Services/ApiConfig.cs"
                           Foreground="#A33" TextAlignment="Center" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- ============ ЗАМЕТКИ ============ -->
        <Grid x:Name="NotesView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Папки -->
            <Grid Grid.Column="0" Background="#ECE5D8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,14,8,6">
                    <TextBlock Text="Папки" FontSize="18" FontFamily="Georgia"
                               Foreground="#26201A" VerticalAlignment="Center"/>
                    <Button Content="＋" Click="OnNewFolderClicked" Background="Transparent"
                            BorderThickness="0" Foreground="#B44F1E" FontSize="16"
                            Padding="10,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Все заметки" Click="OnAllNotesClicked"
                        HorizontalContentAlignment="Left" Padding="12,0" Height="34"
                        Margin="12,0,12,6" Background="#FCFAF6" Foreground="#26201A"
                        BorderBrush="#DED6C8">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <ListBox Grid.Row="2" x:Name="FoldersList" ItemsSource="{Binding Folders}"
                         SelectionChanged="OnFolderSelected" Background="Transparent"
                         BorderThickness="0" Margin="12,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="196">
                                <TextBlock Text="{Binding Name}" Foreground="#26201A"
                                           VerticalAlignment="Center" Margin="4,6,30,6"/>
                                <Button Content="⋯" Click="OnFolderMenuClicked"
                                        HorizontalAlignment="Right" Background="Transparent"
                                        BorderThickness="0" Foreground="#6E6459" Padding="6,0"
                                        ToolTip="Действия с папкой"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,10">
                    <TextBlock x:Name="UserNameLabel" Foreground="#6E6459" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Выйти" Click="OnLogoutClicked" Background="Transparent"
                            BorderThickness="0" Foreground="#B44F1E" FontSize="13"
                            Padding="4,0"/>
                </StackPanel>
            </Grid>

            <!-- Список заметок -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Поиск…" Style="{StaticResource WatermarkTextBox}" Margin="12,14,12,8" Padding="10,7"
                         Background="#FCFAF6" Foreground="#26201A" BorderBrush="#DED6C8"/>
                <ListBox Grid.Row="1" x:Name="NotesList" ItemsSource="{Binding Notes}"
                         SelectionChanged="OnNoteSelected" Background="Transparent"
                         BorderThickness="0" Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="290" Margin="6,8">
                                <TextBlock Text="{Binding Title}" FontSize="15"
                                           FontFamily="Georgia" Foreground="#26201A"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Content}" FontSize="12"
                                           Foreground="#6E6459" TextTrimming="CharacterEllipsis"
                                           MaxWidth="290"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:d MMM}}"
                                           FontSize="11" Foreground="#6E6459" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="＋ Новая заметка" Click="OnNewNoteClicked"
                        Height="40" Margin="12,8,12,14" Background="#B44F1E"
                        Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Редактор -->
            <Grid Grid.Column="2" Background="#FCFAF6" x:Name="EditorGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,16,24,0">
                    <TextBox x:Name="TitleBox" Tag="Без названия" Style="{StaticResource WatermarkTextBox}" FontSize="22"
                             FontFamily="Georgia" Background="Transparent"
                             Foreground="#26201A" BorderThickness="0"
                             Padding="0,4" TextChanged="OnEditorTextChanged"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="PinButton" Content="📌" Click="OnPinClicked"
                                Width="38" Height="38" Background="#ECE5D8"
                                BorderThickness="0" FontSize="15" ToolTip="Закрепить"/>
                        <Button Content="🗑" Click="OnDeleteClicked" Width="38" Height="38"
                                Margin="8,0,0,0" Background="#ECE5D8" BorderThickness="0"
                                FontSize="14" ToolTip="Удалить заметку"/>
                    </StackPanel>
                </Grid>
                <ComboBox Grid.Row="1" x:Name="FolderPicker" Margin="24,6,24,0" Padding="10,6"
                          Background="#ECE5D8" Foreground="#26201A" BorderThickness="0"
                          SelectionChanged="OnFolderPicked"/>
                <TextBox Grid.Row="2" x:Name="ContentBox" Tag="Начните писать…" Style="{StaticResource WatermarkTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True" FontSize="15"
                         Background="Transparent" Foreground="#26201A" BorderThickness="0"
                         Padding="24,12" VerticalScrollBarVisibility="Auto"
                         TextChanged="OnEditorTextChanged"/>
                <TextBlock Grid.Row="3" x:Name="SaveStatus" Text="" FontSize="12"
                           Foreground="#6E6459" Margin="24,6,24,12"/>
            </Grid>

            <!-- Пустое состояние -->
            <StackPanel Grid.Column="2" x:Name="EmptyState" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Выберите заметку слева или создайте новую" FontSize="17"
                           FontFamily="Georgia" Foreground="#6E6459" Margin="0,0,0,16"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                <Button Content="＋ Создать заметку" Click="OnNewNoteClicked" Width="200"
                        Height="42" Background="#B44F1E" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
